{
    "version": 2,
    "framework": null,
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.8.2",
            "includeFiles": "bootstrap/**, config/**, database/**, public/**, resources/**, routes/**, storage/**, vendor/**, app/**"
        }
    },
    "env": {
        "PHP_VERSION": "8.3"
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
