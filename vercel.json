{
    "version": 2,
    "framework": null,
    "buildCommand": "composer install --no-dev --prefer-dist --optimize-autoloader --ignore-platform-reqs && npm run build",
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.3",
            "includeFiles": "bootstrap/**, config/**, database/**, public/**, resources/**, routes/**, storage/**, vendor/**, app/**"
        }
    },
    "routes": [
        {
            "src": "/build/(.*)",
            "dest": "/public/build/$1"
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
